# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://user:password@localhost:5432/alloartisan_dev?schema=public"

# ========================================
# JWT Secrets (CHANGE THESE IN PRODUCTION!)
# Generate with: openssl rand -base64 32
# ========================================
JWT_ACCESS_SECRET="change-me-use-openssl-rand-base64-32"
JWT_REFRESH_SECRET="change-me-use-different-secret-here"

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="change-me"

# ========================================
# Throttler Configuration (Rate Limiting)
# ========================================
# Short: Protection anti-spam rapide
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3

# Medium: Protection par fenêtre de 10 secondes
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20

# Long: Protection par minute
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# ========================================
# CORS Configuration
# Comma-separated list of allowed origins
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ========================================
# Resend Configuration (Email Service)
# ========================================
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY="re_xxxxxxxxxx"
# For testing, use: onboarding@resend.dev
# For production, configure your domain at https://resend.com/domains
RESEND_FROM_EMAIL="AlloArtisan <onboarding@resend.dev>"

# ========================================
# Server Configuration
# ========================================
PORT=3001
NODE_ENV=development
