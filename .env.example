# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://postgres:postgres123@localhost:5438/alloartisan_dev?schema=public"

# ========================================
# JWT Secrets (CHANGE THESE IN PRODUCTION!)
# Générer avec : openssl rand -base64 64
# ========================================
JWT_ACCESS_SECRET="your-super-secret-access-token-key-change-in-production-32chars-min"
JWT_REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production-32chars-min"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# ========================================
# Redis Configuration
# ========================================
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD="redis123"

# ========================================
# Throttler Configuration (Rate Limiting)
# ========================================
# Short: Protection anti-spam rapide
THROTTLE_SHORT_TTL=1000
THROTTLE_SHORT_LIMIT=3

# Medium: Protection par fenêtre de 10 secondes
THROTTLE_MEDIUM_TTL=10000
THROTTLE_MEDIUM_LIMIT=20

# Long: Protection par minute
THROTTLE_LONG_TTL=60000
THROTTLE_LONG_LIMIT=100

# ========================================
# CORS Configuration
# ========================================
CORS_ORIGINS=http://localhost:3000,http://localhost:4200

# ========================================
# Resend Configuration (Email Service)
# ========================================
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="AlloArtisan <noreply@alloartisan.bj>"

# ========================================
# MFA / Chiffrement
# Générer avec : openssl rand -base64 32
# ========================================
MFA_ENCRYPTION_KEY="votre-cle-generee-avec-openssl-rand-base64-32"

# ========================================
# Server Configuration
# ========================================
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ========================================
# Cloudinary (Upload fichiers)
# ========================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ========================================
# Upload Configuration
# ========================================
UPLOAD_TEMP_DIR=./temp-uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_MAX_DAILY_BYTES=52428800

# ========================================
# Firebase FCM (Notifications Push)
# Console : https://console.firebase.google.com
# ========================================
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour key here\n-----END PRIVATE KEY-----\n"

# ========================================
# FedaPay (Paiements)
# Dashboard : https://dashboard.fedapay.com
# ========================================
FEDAPAY_SECRET_KEY=sk_sandbox_xxxxxxxxxxxxxxxxxxxx
FEDAPAY_WEBHOOK_SECRET=your_webhook_secret_40_chars_minimum
FEDAPAY_ENVIRONMENT=sandbox
# En production : sandbox → live

# ========================================
# KkiaPay (Paiements Mobile Money — MTN/Moov Bénin)
# Dashboard : https://dashboard.kkiapay.me
# ========================================
KKIAPAY_PUBLIC_KEY=your_kkiapay_public_key
KKIAPAY_PRIVATE_KEY=your_kkiapay_private_key
KKIAPAY_WEBHOOK_SECRET=your_kkiapay_webhook_secret
KKIAPAY_SANDBOX=true
# En production : KKIAPAY_SANDBOX=false

# ========================================
# Twilio SMS (Phase 2)
# ========================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+22960000000

# ========================================
# Booking Business Rules
# ========================================
BOOKING_EXPIRY_HOURS=24
URGENT_BOOKING_EXPIRY_HOURS=2
COMMISSION_RATE=0.10
REVIEW_DELAY_DAYS=14

# ========================================
# Abonnements (FCFA)
# ========================================
SUBSCRIPTION_STANDARD_PRICE=5000
SUBSCRIPTION_PREMIUM_PRICE=15000
SUBSCRIPTION_STANDARD_REQUESTS=30
SUBSCRIPTION_PREMIUM_REQUESTS=9999

# ========================================
# Monitoring / Health Checks
# ========================================
HEALTH_CHECK_DATABASE_TIMEOUT=3000
HEALTH_CHECK_REDIS_TIMEOUT=1000

# ========================================
# Notifications Rate Limiting
# ========================================
NOTIFICATION_PUSH_RATE_LIMIT=10
NOTIFICATION_PUSH_RATE_WINDOW=3600
NOTIFICATION_EXPIRY_DAYS=30
